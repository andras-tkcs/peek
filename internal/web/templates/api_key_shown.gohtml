{{define "api-key-shown"}}<!doctype html>
<html lang="en" class="bg-background text-foreground antialiased">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} &mdash; Peek</title>
{{template "brand-head" .}}
<link rel="stylesheet" href="{{asset "pines.css"}}">
<script src="{{asset "dashboard-alpine.js"}}" defer></script>
{{template "toast-head" .}}
</head>
<body x-data="dashboard({})" class="grid min-h-screen place-items-center p-6">
<div class="w-full max-w-lg rounded-xl border border-border bg-card p-8 shadow-sm">
  <h2 class="text-lg font-semibold tracking-tight text-card-foreground">{{.Title}}</h2>
  <p class="mt-2 text-sm text-muted-foreground">{{.Name}}</p>
  <div class="mt-4 flex items-center gap-2.5">
    <code id="hn-api-key" class="min-w-0 flex-1 break-all rounded-lg border border-input bg-secondary px-3 py-2 font-mono text-sm text-foreground">{{.Key}}</code>
    <button type="button" data-key="{{.Key}}" x-on:click="copy($el.dataset.key, 'Copied API key.')" class="h-10 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground transition hover:bg-primary/90">Copy</button>
  </div>
  <p class="mt-3 text-sm text-foreground">Copy it now. Peek stores only a hash and cannot show it again.</p>
  {{if .Regenerated}}<p class="mt-2 text-sm text-muted-foreground">The previous key for {{.Name}} has stopped working.</p>{{end}}
  <a href="/dashboard" class="mt-6 inline-block text-sm text-muted-foreground hover:text-foreground">Back to dashboard</a>
</div>
{{template "toast-host" .}}
</body>
</html>{{end}}
