{{define "admin"}}<!doctype html>
<html lang="en" class="bg-background text-foreground antialiased">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Admin &mdash; Peek</title>
{{template "brand-head" .}}
<link rel="stylesheet" href="{{asset "pines.css"}}">
<script src="{{asset "dashboard-alpine.js"}}" defer></script>
{{template "toast-head" .}}
</head>
<body x-data="admin({ googleOAuth: {{.SettingsPanel.Auth.Google.EnabledValue}}, githubOAuth: {{.SettingsPanel.Auth.GitHub.EnabledValue}}, oidcOAuth: {{.SettingsPanel.Auth.OIDC.EnabledValue}}, storageBackend: '{{.SettingsPanel.Storage.Value}}' })" class="min-h-screen">
{{if .FlashSuccess}}<div hidden data-peek-toast data-toast-type="success" data-toast-message="{{.FlashSuccess}}"></div>{{end}}
{{if .Error}}<div hidden data-peek-toast data-toast-type="danger" data-toast-message="{{.Error}}" data-toast-duration="6500"></div>{{end}}
<header class="sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur-xl">
  <div class="mx-auto flex h-14 max-w-5xl items-center px-6">
    {{template "brand-link" .}}
    <nav class="ml-auto flex items-center gap-4">
      <span class="text-sm text-muted-foreground">{{.User}}</span>
      <a href="/dashboard" class="rounded-lg border border-input px-3.5 py-1.5 text-sm text-muted-foreground transition hover:border-border hover:text-secondary-foreground hover:bg-secondary">Dashboard</a>
      <form method="POST" action="/logout" class="m-0">
        <input type="hidden" name="csrf" value="{{.CSRF}}">
        <button type="submit" class="rounded-lg border border-input px-3.5 py-1.5 text-sm text-muted-foreground transition hover:border-border hover:text-secondary-foreground hover:bg-secondary">Sign out</button>
      </form>
    </nav>
  </div>
</header>

<main class="mx-auto flex max-w-5xl flex-col gap-4 px-6 py-8 pb-20">
  {{if not .GoogleOrgSignup}}
  <div class="rounded-xl border border-border bg-card p-5 shadow-sm">
    <h2 class="mb-4 text-base font-semibold tracking-tight text-card-foreground">Invitations <span class="text-xs font-normal text-muted-foreground/70">{{len .Invites}}</span></h2>
    <form method="POST" action="/dashboard/invites" class="mb-4 flex gap-2.5">
      <input type="hidden" name="csrf" value="{{.CSRF}}">
      <input type="email" name="email" placeholder="person@example.com" required class="h-11 min-w-[180px] flex-1 rounded-lg border border-input bg-secondary px-4 text-sm text-foreground placeholder:text-muted-foreground transition focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20">
      <button type="submit" class="h-11 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground transition hover:bg-primary/90">Create invite</button>
    </form>
    {{if .Invites}}
    <div class="overflow-x-auto">
    <table class="w-full border-collapse text-sm">
      <thead><tr class="border-b border-border text-left text-[11px] font-medium uppercase tracking-wider text-muted-foreground"><th class="px-3 py-2">Email</th><th class="px-3 py-2">Status</th><th class="px-3 py-2">Expires</th><th class="px-3 py-2">Link</th><th class="px-3 py-2"></th></tr></thead>
      <tbody>
      {{range .Invites}}
        <tr class="border-b border-border/50 last:border-0 hover:bg-foreground/[0.025]">
          <td class="h-11 px-3">{{.Email}}</td>
          <td class="px-3"><span class="rounded-md px-2 py-0.5 text-[11px] font-semibold {{if eq .Status "pending"}}bg-accent text-accent-foreground{{else}}bg-muted text-muted-foreground{{end}}">{{.Status}}</span></td>
          <td class="px-3 text-muted-foreground">{{.Expires}}</td>
          <td class="px-3">{{if .Link}}
            <button type="button" data-url="{{.Link}}" x-on:click="copyAbsolute($el.dataset.url)" class="peek-link-copy-button" :class="{ 'peek-link-copy-button-copied': copied === absoluteURL($el.dataset.url) }" :aria-label="copied === absoluteURL($el.dataset.url) ? 'Invite link copied' : 'Copy invite link'" title="Copy invite link">
              <span class="peek-link-copy-text">{{.Link}}</span>
              <svg x-show="copied !== absoluteURL($el.closest('button').dataset.url)" class="peek-copy-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25Z" /></svg>
              <svg x-show="copied === absoluteURL($el.closest('button').dataset.url)" x-cloak class="peek-copy-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m7.5 15.75 3 3 6-7.5M8.25 8.25H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V18.75m1.5-15.75c.376.023.75.05 1.124.08 1.131.094 1.976 1.057 1.976 2.192V16.5A2.25 2.25 0 0 1 18 18.75h-2.25m-7.5-10.5h6.375c.621 0 1.125.504 1.125 1.125v9.375" /></svg>
            </button>{{else}}<span class="text-muted-foreground/70">{{.Status}}</span>{{end}}
          </td>
          <td class="px-3">
            <div class="peek-row-actions">
              {{if .CanRevoke}}
              <form method="POST" action="/dashboard/invites/revoke/{{.ID}}" class="m-0">
                <input type="hidden" name="csrf" value="{{$.CSRF}}">
                <button type="submit" class="peek-row-button peek-row-button-danger">Revoke</button>
              </form>
              {{end}}
            </div>
          </td>
        </tr>
      {{end}}
      </tbody>
    </table>
    </div>
    {{end}}
  </div>
  {{end}}

  <div class="rounded-xl border border-border bg-card p-5 shadow-sm">
    <h2 class="mb-4 text-base font-semibold tracking-tight text-card-foreground">Users <span class="text-xs font-normal text-muted-foreground/70">{{len .Accounts}}</span></h2>
    <div class="overflow-x-auto">
    <table class="w-full border-collapse text-sm">
      <thead><tr class="border-b border-border text-left text-[11px] font-medium uppercase tracking-wider text-muted-foreground"><th class="px-3 py-2">Name</th><th class="px-3 py-2">Email</th><th class="px-3 py-2">Admin</th><th class="px-3 py-2">Status</th><th class="px-3 py-2"></th></tr></thead>
      <tbody>
      {{range .Accounts}}
        <tr class="border-b border-border/50 last:border-0 hover:bg-foreground/[0.025]">
          <td class="h-11 px-3">{{.Name}}{{if .IsSelf}} <span class="text-muted-foreground">(you)</span>{{end}}{{if .ManagedBy}} <span class="rounded-md bg-muted px-2 py-0.5 text-[11px] font-semibold text-muted-foreground">Managed by {{.ManagedBy}}</span>{{end}}</td>
          <td class="px-3 text-muted-foreground">{{if .Email}}{{.Email}}{{else}}token-only{{end}}</td>
          <td class="px-3">{{if .Admin}}<span class="rounded-md bg-accent px-2 py-0.5 text-[11px] font-semibold text-accent-foreground">admin</span>{{else}}<span class="rounded-md bg-muted px-2 py-0.5 text-[11px] font-semibold text-muted-foreground">user</span>{{end}}</td>
          <td class="px-3">{{if .Disabled}}<span class="rounded-md bg-destructive/10 px-2 py-0.5 text-[11px] font-semibold text-destructive">disabled</span>{{else}}<span class="rounded-md bg-accent px-2 py-0.5 text-[11px] font-semibold text-accent-foreground">active</span>{{end}}</td>
          <td class="px-3">
            <div class="peek-row-actions">
              <form method="POST" action="/dashboard/users/{{.ID}}/admin" class="m-0">
                <input type="hidden" name="csrf" value="{{$.CSRF}}">
                <input type="hidden" name="admin" value="{{if .Admin}}false{{else}}true{{end}}">
                <button type="submit" class="peek-row-button">{{if .Admin}}Remove admin{{else}}Make admin{{end}}</button>
              </form>
              <form method="POST" action="/dashboard/users/{{.ID}}/disabled" class="m-0">
                <input type="hidden" name="csrf" value="{{$.CSRF}}">
                <input type="hidden" name="disabled" value="{{if .Disabled}}false{{else}}true{{end}}">
                <button type="submit" class="peek-row-button{{if not .Disabled}} peek-row-button-danger{{end}}">{{if .Disabled}}Enable{{else}}Disable{{end}}</button>
              </form>
            </div>
          </td>
        </tr>
      {{end}}
      </tbody>
    </table>
    </div>
  </div>

  <div class="rounded-xl border border-border bg-card p-5 shadow-sm">
    <h2 class="mb-4 text-base font-semibold tracking-tight text-card-foreground">Provisioners <span class="text-xs font-normal text-muted-foreground/70">{{len .Provisioners}}</span></h2>
    {{if .Provisioners}}
    <div class="overflow-x-auto">
    <table class="w-full border-collapse text-sm">
      <thead><tr class="border-b border-border text-left text-[11px] font-medium uppercase tracking-wider text-muted-foreground"><th class="px-3 py-2">Name</th><th class="px-3 py-2">Key</th><th class="px-3 py-2">Created</th><th class="px-3 py-2">Last used</th><th class="px-3 py-2">Accounts</th><th class="px-3 py-2"></th></tr></thead>
      <tbody>
      {{range .Provisioners}}
        <tr class="border-b border-border/50 last:border-0 hover:bg-foreground/[0.025]">
          <td class="h-11 px-3">{{.Name}}</td>
          <td class="px-3 text-muted-foreground">{{if .Hint}}…{{.Hint}}{{end}}</td>
          <td class="px-3 text-muted-foreground">{{.Created}}</td>
          <td class="px-3 text-muted-foreground">{{.LastUsed}}</td>
          <td class="px-3 text-muted-foreground">{{.Accounts}}</td>
          <td class="px-3">
            {{if .FromFile}}
            <span class="text-xs text-muted-foreground">Registered from PEEK_PROVISIONING_KEY_FILE: replace the file and restart to rotate it.</span>
            {{else}}
            <div class="peek-row-actions">
              <form method="POST" action="/dashboard/provisioners/{{.ID}}/revoke" class="m-0">
                <input type="hidden" name="csrf" value="{{$.CSRF}}">
                <button type="submit" class="peek-row-button peek-row-button-danger">Revoke</button>
              </form>
            </div>
            {{end}}
          </td>
        </tr>
      {{end}}
      </tbody>
    </table>
    </div>
    {{else}}
    <p class="text-sm text-muted-foreground">No provisioning keys.</p>
    {{end}}
    <p class="mt-3 text-xs text-muted-foreground">Create a provisioning key with peek provisioner create --name &lt;name&gt;. Revoking a key signs every account it manages out of that system; the accounts and their pages stay.</p>
  </div>

  <div class="rounded-xl border border-border bg-card p-5 shadow-sm">
    <h2 class="mb-4 text-base font-semibold tracking-tight text-card-foreground">Settings</h2>
    <form method="POST" action="/dashboard/settings" class="flex flex-col gap-5">
      <input type="hidden" name="csrf" value="{{.CSRF}}">

      <div class="peek-settings-tab-list" role="tablist" aria-label="Settings sections">
        <button type="button" class="peek-settings-tab" :class="{ 'peek-settings-tab-active': settingsTab === 'auth' }" x-on:click="settingsTab = 'auth'" role="tab" :aria-selected="settingsTab === 'auth'">Auth</button>
        <button type="button" class="peek-settings-tab" :class="{ 'peek-settings-tab-active': settingsTab === 'storage' }" x-on:click="settingsTab = 'storage'" role="tab" :aria-selected="settingsTab === 'storage'">Storage</button>
        <button type="button" class="peek-settings-tab" :class="{ 'peek-settings-tab-active': settingsTab === 'limits' }" x-on:click="settingsTab = 'limits'" role="tab" :aria-selected="settingsTab === 'limits'">Limits</button>
        <button type="button" class="peek-settings-tab" :class="{ 'peek-settings-tab-active': settingsTab === 'email' }" x-on:click="settingsTab = 'email'" role="tab" :aria-selected="settingsTab === 'email'">Email</button>
        <button type="button" class="peek-settings-tab" :class="{ 'peek-settings-tab-active': settingsTab === 'backends' }" x-on:click="settingsTab = 'backends'" role="tab" :aria-selected="settingsTab === 'backends'">Backends</button>
      </div>

      <div x-show="settingsTab === 'auth'" class="flex flex-col gap-4">
        <label class="peek-setting-switch">
          <span class="peek-switch-control">
            <input type="checkbox" role="switch" name="{{.SettingsPanel.Auth.Token.Key}}" value="true" {{if .SettingsPanel.Auth.Token.Value}}checked{{end}} class="peek-switch-input">
            <span class="peek-switch-track" aria-hidden="true"><span class="peek-switch-thumb"></span></span>
          </span>
          <span class="flex min-w-0 flex-col gap-1">
            <span class="text-sm text-secondary-foreground">{{.SettingsPanel.Auth.Token.Label}}</span>
            <span class="text-xs text-muted-foreground">{{.SettingsPanel.Auth.Token.Description}}</span>
          </span>
        </label>

        <label class="flex flex-col gap-1">
          <span class="text-sm text-secondary-foreground">{{.SettingsPanel.Auth.Domain.Label}}</span>
          <input type="text" name="{{.SettingsPanel.Auth.Domain.Key}}" value="{{.SettingsPanel.Auth.Domain.Value}}" placeholder="example.com" autocomplete="off" {{if .SettingsPanel.Auth.Domain.LockedBy}}disabled {{end}}class="h-11 rounded-lg border border-input bg-secondary px-4 text-sm text-foreground placeholder:text-muted-foreground transition focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20 disabled:opacity-60">
          <span class="text-xs text-muted-foreground">{{.SettingsPanel.Auth.Domain.Description}}</span>
          {{if .SettingsPanel.Auth.Domain.LockedBy}}<span class="text-xs text-muted-foreground">Set by {{.SettingsPanel.Auth.Domain.LockedBy}} on the server</span>{{end}}
        </label>

        <label class="peek-setting-switch">
          <span class="peek-switch-control">
            <input type="checkbox" role="switch" name="{{.SettingsPanel.Auth.GoogleOrg.Key}}" value="true" {{if .SettingsPanel.Auth.GoogleOrg.Value}}checked{{end}} {{if .SettingsPanel.Auth.GoogleOrg.LockedBy}}disabled {{end}}class="peek-switch-input">
            <span class="peek-switch-track" aria-hidden="true"><span class="peek-switch-thumb"></span></span>
          </span>
          <span class="flex min-w-0 flex-col gap-1">
            <span class="text-sm text-secondary-foreground">{{.SettingsPanel.Auth.GoogleOrg.Label}}</span>
            <span class="text-xs text-muted-foreground">{{.SettingsPanel.Auth.GoogleOrg.Description}}</span>
            {{if .SettingsPanel.Auth.GoogleOrg.LockedBy}}<span class="text-xs text-muted-foreground">Set by {{.SettingsPanel.Auth.GoogleOrg.LockedBy}} on the server</span>{{end}}
          </span>
        </label>

        <label class="peek-setting-switch">
          <span class="peek-switch-control">
            <input type="checkbox" role="switch" name="{{.SettingsPanel.Auth.OIDCSignup.Key}}" value="true" {{if .SettingsPanel.Auth.OIDCSignup.Value}}checked{{end}} {{if .SettingsPanel.Auth.OIDCSignup.LockedBy}}disabled {{end}}class="peek-switch-input">
            <span class="peek-switch-track" aria-hidden="true"><span class="peek-switch-thumb"></span></span>
          </span>
          <span class="flex min-w-0 flex-col gap-1">
            <span class="text-sm text-secondary-foreground">{{.SettingsPanel.Auth.OIDCSignup.Label}}</span>
            <span class="text-xs text-muted-foreground">{{.SettingsPanel.Auth.OIDCSignup.Description}}</span>
            {{if .SettingsPanel.Auth.OIDCSignup.LockedBy}}<span class="text-xs text-muted-foreground">Set by {{.SettingsPanel.Auth.OIDCSignup.LockedBy}} on the server</span>{{end}}
          </span>
        </label>

        {{range .SettingsPanel.Auth.Providers}}
        {{$providerKey := .Key}}
        <div class="peek-provider-settings">
          <label class="peek-setting-switch">
            <span class="peek-switch-control">
              <input type="checkbox" role="switch" name="{{.Enabled.Key}}" value="true" x-model="oauth.{{.Key}}" {{if .EnabledValue}}checked{{end}} {{if .Enabled.LockedBy}}disabled {{end}}class="peek-switch-input">
              <span class="peek-switch-track" aria-hidden="true"><span class="peek-switch-thumb"></span></span>
            </span>
            <span class="flex min-w-0 flex-col gap-1">
              <span class="text-sm text-secondary-foreground">{{.Enabled.Label}}</span>
              <span class="text-xs text-muted-foreground">{{.Enabled.Description}}</span>
              {{if .Enabled.LockedBy}}<span class="text-xs text-muted-foreground">Set by {{.Enabled.LockedBy}} on the server</span>{{end}}
            </span>
          </label>
          <div x-show="oauth.{{.Key}}" x-cloak class="grid gap-3 md:grid-cols-2">
            {{range .Fields}}
            <label class="flex flex-col gap-1">
              <span class="text-sm text-secondary-foreground">{{.Label}}</span>
              <input type="{{if .IsSecret}}password{{else}}text{{end}}" name="{{.Key}}" value="{{.Value}}" placeholder="{{.Description}}" autocomplete="off" {{if .LockedBy}}disabled{{else}}:disabled="!oauth.{{$providerKey}}"{{end}} class="h-11 rounded-lg border border-input bg-secondary px-4 text-sm text-foreground placeholder:text-muted-foreground transition focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20 disabled:opacity-60">
              <span class="text-xs text-muted-foreground">{{.Description}}</span>
              {{if .LockedBy}}<span class="text-xs text-muted-foreground">Set by {{.LockedBy}} on the server</span>{{end}}
            </label>
            {{end}}
          </div>
        </div>
        {{end}}
      </div>

      <div x-show="settingsTab === 'storage'" x-cloak class="flex flex-col gap-4">
        <div class="flex flex-col gap-2">
          <span class="text-sm text-secondary-foreground">{{.SettingsPanel.Storage.Backend.Label}} {{if .SettingsPanel.Storage.Backend.IsStartup}}<em class="text-xs text-muted-foreground not-italic">(restart to apply)</em>{{end}}</span>
          <div class="peek-segmented-control">
            <label class="peek-segmented-option" :class="{ 'peek-segmented-option-active': storageBackend === 'file' }">
              <input type="radio" name="{{.SettingsPanel.Storage.Backend.Key}}" value="file" x-model="storageBackend" {{if eq .SettingsPanel.Storage.Value "file"}}checked{{end}} class="sr-only">
              <span>File</span>
            </label>
            <label class="peek-segmented-option" :class="{ 'peek-segmented-option-active': storageBackend === 's3' }">
              <input type="radio" name="{{.SettingsPanel.Storage.Backend.Key}}" value="s3" x-model="storageBackend" {{if .SettingsPanel.Storage.S3Selected}}checked{{end}} class="sr-only">
              <span>S3</span>
            </label>
          </div>
          <span class="text-xs text-muted-foreground">{{.SettingsPanel.Storage.Backend.Description}}</span>
        </div>

        <div x-show="storageBackend === 's3'" x-cloak class="grid gap-3 md:grid-cols-2">
          {{range .SettingsPanel.Storage.S3Settings}}
          <label class="flex flex-col gap-1">
            <span class="text-sm text-secondary-foreground">{{.Label}}</span>
            <input type="{{if .IsSecret}}password{{else}}text{{end}}" name="{{.Key}}" value="{{.Value}}" placeholder="{{.Description}}" autocomplete="off" :disabled="storageBackend !== 's3'" class="h-11 rounded-lg border border-input bg-secondary px-4 text-sm text-foreground placeholder:text-muted-foreground transition focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20 disabled:opacity-60">
            <span class="text-xs text-muted-foreground">{{.Description}}</span>
          </label>
          {{end}}
        </div>
      </div>

      <div x-show="settingsTab === 'limits'" x-cloak class="flex flex-col gap-4">
        {{range .SettingsPanel.Limits}}
        <div class="peek-limit-control md:grid-cols-[minmax(0,1fr)_160px] md:items-center">
          <div class="flex flex-col gap-1">
            <label for="setting-{{.Key}}" class="text-sm text-secondary-foreground">{{.Label}}</label>
            <span class="text-xs text-muted-foreground">{{.Description}}</span>
          </div>
          <div class="flex h-11 overflow-hidden rounded-lg border border-input bg-secondary focus-within:border-ring focus-within:ring-2 focus-within:ring-ring/20">
            <input id="setting-{{.Key}}" type="number" name="{{.FormKey}}" min="{{.Min}}" max="{{.Max}}" step="{{.Step}}" value="{{.Value}}" class="min-w-0 flex-1 bg-transparent px-3 text-sm text-foreground focus:outline-none">
            <span class="flex min-w-14 items-center justify-center border-l border-border px-3 text-xs font-medium text-muted-foreground">{{.Unit}}</span>
          </div>
        </div>
        {{end}}
      </div>

      <div x-show="settingsTab === 'email'" x-cloak class="flex flex-col gap-4">
        <div class="grid gap-3 md:grid-cols-2">
          <label class="flex flex-col gap-1">
            <span class="text-sm text-secondary-foreground">{{.SettingsPanel.Email.Host.Label}}</span>
            <input type="text" name="{{.SettingsPanel.Email.Host.Key}}" value="{{.SettingsPanel.Email.Host.Value}}" placeholder="{{.SettingsPanel.Email.Host.Description}}" autocomplete="off" class="h-11 rounded-lg border border-input bg-secondary px-4 text-sm text-foreground placeholder:text-muted-foreground transition focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20">
            <span class="text-xs text-muted-foreground">{{.SettingsPanel.Email.Host.Description}}</span>
          </label>
          <label class="flex flex-col gap-1">
            <span class="text-sm text-secondary-foreground">{{.SettingsPanel.Email.Port.Label}}</span>
            <input type="text" name="{{.SettingsPanel.Email.Port.Key}}" value="{{.SettingsPanel.Email.Port.Value}}" placeholder="{{.SettingsPanel.Email.Port.Description}}" autocomplete="off" class="h-11 rounded-lg border border-input bg-secondary px-4 text-sm text-foreground placeholder:text-muted-foreground transition focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20">
            <span class="text-xs text-muted-foreground">{{.SettingsPanel.Email.Port.Description}}</span>
          </label>
          <label class="flex flex-col gap-1">
            <span class="text-sm text-secondary-foreground">{{.SettingsPanel.Email.TLS.Label}}</span>
            <select name="{{.SettingsPanel.Email.TLS.Key}}" class="h-11 rounded-lg border border-input bg-secondary px-4 text-sm text-foreground placeholder:text-muted-foreground transition focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20">
              <option value="starttls"{{if eq .SettingsPanel.Email.TLSValue "starttls"}} selected{{end}}>starttls</option>
              <option value="tls"{{if eq .SettingsPanel.Email.TLSValue "tls"}} selected{{end}}>tls</option>
              <option value="none"{{if eq .SettingsPanel.Email.TLSValue "none"}} selected{{end}}>none</option>
            </select>
            <span class="text-xs text-muted-foreground">{{.SettingsPanel.Email.TLS.Description}}</span>
          </label>
          <label class="flex flex-col gap-1">
            <span class="text-sm text-secondary-foreground">{{.SettingsPanel.Email.Username.Label}}</span>
            <input type="text" name="{{.SettingsPanel.Email.Username.Key}}" value="{{.SettingsPanel.Email.Username.Value}}" placeholder="{{.SettingsPanel.Email.Username.Description}}" autocomplete="off" class="h-11 rounded-lg border border-input bg-secondary px-4 text-sm text-foreground placeholder:text-muted-foreground transition focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20">
            <span class="text-xs text-muted-foreground">{{.SettingsPanel.Email.Username.Description}}</span>
          </label>
          <label class="flex flex-col gap-1">
            <span class="text-sm text-secondary-foreground">{{.SettingsPanel.Email.Password.Label}}</span>
            <input type="password" name="{{.SettingsPanel.Email.Password.Key}}" value="{{.SettingsPanel.Email.Password.Value}}" placeholder="{{.SettingsPanel.Email.Password.Description}}" autocomplete="off" class="h-11 rounded-lg border border-input bg-secondary px-4 text-sm text-foreground placeholder:text-muted-foreground transition focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20">
            <span class="text-xs text-muted-foreground">{{.SettingsPanel.Email.Password.Description}}</span>
          </label>
          <label class="flex flex-col gap-1">
            <span class="text-sm text-secondary-foreground">{{.SettingsPanel.Email.From.Label}}</span>
            <input type="text" name="{{.SettingsPanel.Email.From.Key}}" value="{{.SettingsPanel.Email.From.Value}}" placeholder="{{.SettingsPanel.Email.From.Description}}" autocomplete="off" class="h-11 rounded-lg border border-input bg-secondary px-4 text-sm text-foreground placeholder:text-muted-foreground transition focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20">
            <span class="text-xs text-muted-foreground">{{.SettingsPanel.Email.From.Description}}</span>
          </label>
        </div>
        <div class="flex flex-col gap-2">
          <button type="submit" form="hn-email-test" class="peek-row-button self-start">Send test email</button>
          <span class="text-xs text-muted-foreground">Sends a test email to your own address using the saved settings. Save first.</span>
        </div>
      </div>

      <div x-show="settingsTab === 'backends'" x-cloak class="flex flex-col gap-4">
        {{if not .SettingsPanel.Backends.Enabled}}<p class="text-sm text-muted-foreground">Backends are off. Start peekd with --backends docker to run page backends.</p>{{end}}
        <div class="grid gap-3 md:grid-cols-2">
          {{range .SettingsPanel.Backends.Fields}}
          <label class="flex flex-col gap-1">
            <span class="text-sm text-secondary-foreground">{{.Label}}</span>
            <input type="{{if .IsSecret}}password{{else}}text{{end}}" name="{{.Key}}" value="{{.Value}}" autocomplete="off" class="h-11 rounded-lg border border-input bg-secondary px-4 text-sm text-foreground placeholder:text-muted-foreground transition focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20">
            <span class="text-xs text-muted-foreground">{{.Description}}</span>
          </label>
          {{end}}
        </div>
      </div>

      <button type="submit" class="self-start h-11 rounded-lg bg-primary px-5 text-sm font-medium text-primary-foreground transition hover:bg-primary/90">Save settings</button>
    </form>
    <form id="hn-email-test" method="POST" action="/dashboard/email/test" class="m-0">
      <input type="hidden" name="csrf" value="{{.CSRF}}">
    </form>
  </div>
</main>
{{template "toast-host" .}}
</body>
</html>{{end}}
