{{define "dashboard"}}<!doctype html>
<html lang="en" class="bg-background text-foreground antialiased">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Dashboard &mdash; Peek</title>
{{template "brand-head" .}}
<link rel="stylesheet" href="{{asset "pines.css"}}">
<script src="{{asset "dashboard-alpine.js"}}" defer></script>
{{template "toast-head" .}}
</head>
<body x-data="dashboard()" class="min-h-screen">
{{if .UploadSuccessURL}}<div hidden data-peek-toast data-toast-type="success" data-toast-message="Uploaded! Share link:" data-toast-description="{{.UploadSuccessURL}}" data-toast-duration="8000"></div>{{end}}
{{if .FlashSuccess}}<div hidden data-peek-toast data-toast-type="success" data-toast-message="{{.FlashSuccess}}"></div>{{end}}
{{if .UploadError}}<div hidden data-peek-toast data-toast-type="danger" data-toast-message="{{.UploadError}}" data-toast-duration="6500"></div>{{end}}
<header class="sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur-xl">
  <div class="mx-auto flex h-14 max-w-5xl items-center px-6">
    {{template "brand-link" .}}
    <nav class="ml-auto flex items-center gap-4">
      <span class="text-sm text-muted-foreground">{{.User}}</span>
      <form method="POST" action="/dashboard/sessions/revoke" data-confirm="Sign out of Peek in every other browser? This browser stays signed in and API keys keep working." x-on:submit="confirm($event, $el.dataset.confirm)" class="m-0">
        <input type="hidden" name="csrf" value="{{.CSRF}}">
        <button type="submit" class="rounded-lg border border-input px-3.5 py-1.5 text-sm text-muted-foreground transition hover:border-border hover:text-secondary-foreground hover:bg-secondary">Sign out other sessions</button>
      </form>
      {{if .IsAdmin}}<a href="/admin" class="rounded-lg border border-input px-3.5 py-1.5 text-sm text-muted-foreground transition hover:border-border hover:text-secondary-foreground hover:bg-secondary">Admin</a>{{end}}
      <form method="POST" action="/logout" class="m-0">
        <input type="hidden" name="csrf" value="{{.CSRF}}">
        <button type="submit" class="rounded-lg border border-input px-3.5 py-1.5 text-sm text-muted-foreground transition hover:border-border hover:text-secondary-foreground hover:bg-secondary">Sign out</button>
      </form>
    </nav>
  </div>
</header>

<main class="mx-auto flex max-w-5xl flex-col gap-4 px-6 py-8 pb-20">
  <div class="rounded-xl border border-border bg-card p-5 shadow-sm">
    <h2 class="mb-4 text-base font-semibold tracking-tight text-card-foreground">Upload HTML</h2>
    <form method="POST" action="/dashboard/upload" enctype="multipart/form-data" x-on:submit="guardUploadSubmit($event)" class="flex flex-col gap-3.5">
      <input type="hidden" name="csrf" value="{{.CSRF}}">
      <div class="inline-flex gap-0.5 self-start rounded-lg bg-muted p-0.5">
        <label class="cursor-pointer rounded-md px-3 py-1.5 text-sm transition" :class="mode === 'file' ? 'bg-background text-foreground shadow-sm' : 'text-muted-foreground'">
          <input type="radio" name="mode" value="file" x-model="mode" class="sr-only"> Choose file
        </label>
        <label class="cursor-pointer rounded-md px-3 py-1.5 text-sm transition" :class="mode === 'paste' ? 'bg-background text-foreground shadow-sm' : 'text-muted-foreground'">
          <input type="radio" name="mode" value="paste" x-model="mode" class="sr-only"> Paste HTML
        </label>
        <label class="cursor-pointer rounded-md px-3 py-1.5 text-sm transition" :class="mode === 'empty' ? 'bg-background text-foreground shadow-sm' : 'text-muted-foreground'">
          <input type="radio" name="mode" value="empty" x-model="mode" class="sr-only"> Empty page
        </label>
      </div>
      <div x-show="mode === 'file'">
        <label class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-lg border p-6 transition hover:border-primary hover:text-secondary-foreground hover:bg-accent" :class="fileName ? 'border-primary/40 bg-accent text-secondary-foreground' : 'border-input bg-secondary text-muted-foreground'">
          <input type="file" name="file" accept=".html,.htm,text/html" x-on:change="setSelectedFile($event.target.files && $event.target.files[0])" class="absolute h-px w-px opacity-0">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="opacity-70"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          <span class="max-w-full truncate text-sm font-medium" x-text="fileName || 'Click to choose an HTML file'">Click to choose an HTML file</span>
          <span x-show="fileName" x-cloak class="text-xs text-muted-foreground" x-text="fileSizeLabel ? fileSizeLabel + ' selected' : 'File selected'"></span>
        </label>
      </div>
      <div x-show="mode === 'paste'">
        <textarea name="html" x-model="html" placeholder="<!doctype html>&#10;<html>&#10;  <body>&#10;    <h1>Hello</h1>&#10;  </body>&#10;</html>" rows="8" class="w-full resize-y rounded-lg border border-input bg-secondary px-3.5 py-3 font-mono text-xs text-foreground placeholder:text-muted-foreground transition focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20"></textarea>
      </div>
      <div class="flex gap-3">
        <input type="text" name="name" x-model="name" :required="mode === 'empty'" placeholder="page name" class="flex-1 h-10 rounded-lg border border-input bg-secondary px-4 text-sm text-foreground placeholder:text-muted-foreground transition focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20">
      </div>
      <div class="inline-flex gap-0.5 self-start rounded-lg bg-muted p-0.5">
        <label class="cursor-pointer rounded-md px-3 py-1.5 text-sm transition" :class="visibility === 'restricted' ? 'bg-background text-foreground shadow-sm' : 'text-muted-foreground'">
          <input type="radio" name="visibility" value="restricted" x-model="visibility" class="sr-only"> Restricted
        </label>
        <label class="cursor-pointer rounded-md px-3 py-1.5 text-sm transition" :class="visibility === 'signed-in' ? 'bg-background text-foreground shadow-sm' : 'text-muted-foreground'">
          <input type="radio" name="visibility" value="signed-in" x-model="visibility" class="sr-only"> Signed-in users
        </label>
        <label class="cursor-pointer rounded-md px-3 py-1.5 text-sm transition" :class="visibility === 'public' ? 'bg-background text-foreground shadow-sm' : 'text-muted-foreground'">
          <input type="radio" name="visibility" value="public" x-model="visibility" class="sr-only"> Public
        </label>
      </div>
      <button type="submit" :disabled="!canUpload()" class="self-start h-10 rounded-lg bg-primary px-5 text-sm font-medium text-primary-foreground transition hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:bg-primary" x-text="mode === 'empty' ? 'Create page' : 'Upload & get link'">Upload &amp; get link</button>
    </form>
  </div>

  <div class="rounded-xl border border-border bg-card p-5 shadow-sm">
    <h2 class="mb-4 text-base font-semibold tracking-tight text-card-foreground">Pages <span class="text-xs font-normal text-muted-foreground/70">{{len .Uploads}}</span></h2>
    {{if .Uploads}}
    <div class="overflow-x-auto">
    <table class="w-full border-collapse text-sm">
      <thead><tr class="border-b border-border text-left text-[11px] font-medium uppercase tracking-wider text-muted-foreground"><th class="px-3 py-2">Page</th><th class="px-3 py-2">Size</th><th class="px-3 py-2">Visibility</th><th class="px-3 py-2">Created</th><th class="px-3 py-2"></th></tr></thead>
      <tbody>
      {{range .Uploads}}
        <tr class="border-b border-border/50 last:border-0 hover:bg-foreground/[0.025]">
          <td class="h-10 w-full max-w-0 px-3">
            <div class="flex min-w-0 items-center gap-2 whitespace-nowrap">
              {{if eq .Role "viewer"}}<span role="img" title="Shared with you by {{.OwnerName}}. View only" aria-label="Shared with you, view only"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4 shrink-0 text-muted-foreground" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg></span>
              {{else if eq .Role "admin"}}<span role="img" title="Owned by {{.OwnerName}}. You can edit it as an admin" aria-label="Owned by {{.OwnerName}}, editable as admin"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4 shrink-0 text-muted-foreground" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"/></svg></span>
              {{else}}<span role="img" title="You own this page and can edit it" aria-label="Owned by you"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-4 w-4 shrink-0 text-muted-foreground" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10"/></svg></span>
              {{end}}<a href="/p/{{.Slug}}" target="_blank" title="{{.Name}}" class="min-w-0 truncate font-medium text-primary no-underline hover:underline">{{.Name}}</a>
            </div>
          </td>
          <td class="whitespace-nowrap px-3 text-muted-foreground">{{.SizeHuman}}</td>
          <td class="px-3"><span class="rounded-md bg-accent px-2 py-0.5 text-[11px] font-semibold text-accent-foreground">{{.Visibility}}</span></td>
          <td class="whitespace-nowrap px-3 text-muted-foreground">{{.CreatedHuman}}</td>
          <td class="px-3">
            {{if ne .Role "viewer"}}<div class="peek-row-actions">
              <div x-data="{ vis: '{{.Visibility}}' }" x-init="{{if eq $.ManageSlug .Slug}}$nextTick(() => $refs.visibilityDialog.showModal()){{end}}" class="m-0">
                <button type="button" class="peek-row-button" x-on:click="$refs.visibilityDialog.showModal()">Access</button>
                <dialog x-ref="visibilityDialog" class="peek-visibility-dialog" aria-labelledby="hn-visibility-title-{{.Slug}}">
                  <form method="POST" action="/dashboard/rename/{{.Slug}}" class="mb-4 flex flex-col gap-2 border-b border-border pb-4">
                    <input type="hidden" name="csrf" value="{{$.CSRF}}">
                    <label for="hn-rename-{{.Slug}}" class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Name</label>
                    <div class="flex gap-2">
                      <input id="hn-rename-{{.Slug}}" type="text" name="name" value="{{.Name}}" required maxlength="200" class="h-9 min-w-0 flex-1 rounded-lg border border-input bg-secondary px-3 text-sm text-foreground placeholder:text-muted-foreground transition focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20">
                      <button type="submit" class="h-9 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground transition hover:bg-primary/90">Rename</button>
                    </div>
                    <p class="text-xs text-muted-foreground">The link follows the new name. Old links keep redirecting here.</p>
                  </form>
                  <form method="POST" action="/dashboard/visibility/{{.Slug}}" class="flex flex-col gap-3.5">
                    <input type="hidden" name="csrf" value="{{$.CSRF}}">
                    <h3 id="hn-visibility-title-{{.Slug}}" class="text-sm font-semibold text-card-foreground">Access for {{.Name}}</h3>
                    <div class="inline-flex gap-0.5 self-start rounded-lg bg-muted p-0.5">
                      <label class="cursor-pointer rounded-md px-3 py-1.5 text-sm transition" :class="vis === 'restricted' ? 'bg-background text-foreground shadow-sm' : 'text-muted-foreground'">
                        <input type="radio" name="visibility" value="restricted" x-model="vis" class="sr-only"> Restricted
                      </label>
                      <label class="cursor-pointer rounded-md px-3 py-1.5 text-sm transition" :class="vis === 'signed-in' ? 'bg-background text-foreground shadow-sm' : 'text-muted-foreground'">
                        <input type="radio" name="visibility" value="signed-in" x-model="vis" class="sr-only"> Signed-in users
                      </label>
                      <label class="cursor-pointer rounded-md px-3 py-1.5 text-sm transition" :class="vis === 'public' ? 'bg-background text-foreground shadow-sm' : 'text-muted-foreground'">
                        <input type="radio" name="visibility" value="public" x-model="vis" class="sr-only"> Public
                      </label>
                    </div>
                    <div class="flex justify-end gap-2">
                      <button type="button" class="peek-row-button" x-on:click="$refs.visibilityDialog.close()">Close</button>
                      <button type="submit" class="h-9 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground transition hover:bg-primary/90">Save</button>
                    </div>
                  </form>
                  {{$slug := .Slug}}
                  <section x-show="vis === 'restricted' || {{if .Grants}}true{{else}}false{{end}}" class="mt-4 flex flex-col gap-2.5 border-t border-border pt-4">
                    <h4 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">People and groups with access</h4>
                    {{if ne .Visibility "restricted"}}<p class="text-xs text-muted-foreground">Grants apply once you save Restricted above.</p>{{end}}
                    {{if .Grants}}
                    <ul class="flex flex-col gap-1">
                      {{range .Grants}}
                      <li class="flex items-center justify-between gap-2 text-sm">
                        <span class="truncate">{{.Email}}{{if eq .Kind "group"}} <span class="text-xs text-muted-foreground">(group)</span>{{end}}</span>
                        <form method="POST" action="/dashboard/grants/{{$slug}}/remove" class="m-0">
                          <input type="hidden" name="csrf" value="{{$.CSRF}}">
                          <input type="hidden" name="kind" value="{{.Kind}}">
                          <input type="hidden" name="email" value="{{.Email}}">
                          <button type="submit" class="peek-row-button peek-row-button-danger">Remove</button>
                        </form>
                      </li>
                      {{end}}
                    </ul>
                    {{else}}
                    <p class="text-xs text-muted-foreground">Only you and admins can open this page until you share it.</p>
                    {{end}}
                    <form method="POST" action="/dashboard/grants/{{.Slug}}" class="flex gap-2">
                      <input type="hidden" name="csrf" value="{{$.CSRF}}">
                      {{if $.GroupGrantsEnabled}}
                      <select name="kind" aria-label="Grant type" class="h-9 rounded-lg border border-input bg-secondary px-2 text-sm text-foreground">
                        <option value="user">Person</option>
                        <option value="group">Google group</option>
                      </select>
                      {{else}}
                      <input type="hidden" name="kind" value="user">
                      {{end}}
                      <input type="email" name="email" required maxlength="254" placeholder="name@example.com" aria-label="Email address" class="h-9 min-w-0 flex-1 rounded-lg border border-input bg-secondary px-3 text-sm text-foreground placeholder:text-muted-foreground transition focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20">
                      <button type="submit" class="h-9 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground transition hover:bg-primary/90">Share</button>
                    </form>
                  </section>
                </dialog>
              </div>
              <a href="/dashboard/stats/{{.Slug}}" class="peek-row-button">Stats</a>
              <form method="POST" action="/dashboard/delete/{{.Slug}}" data-confirm="Delete {{.Name}}? This cannot be undone." x-on:submit="confirm($event, $el.dataset.confirm)" class="m-0">
                <input type="hidden" name="csrf" value="{{$.CSRF}}">
                <button type="submit" class="peek-row-button peek-row-button-danger">Delete</button>
              </form>
            </div>{{end}}
          </td>
        </tr>
      {{end}}
      </tbody>
    </table>
    </div>
    {{else}}
    <div class="py-10 text-center">
      <p class="text-sm text-foreground">No pages yet.</p>
      <p class="mt-1.5 text-xs text-muted-foreground">Upload an HTML file or paste HTML above. Pages people share with you show up here too.</p>
    </div>
    {{end}}
  </div>

  <div class="rounded-xl border border-border bg-card p-5 shadow-sm">
    <h2 class="mb-1 text-base font-semibold tracking-tight text-card-foreground">API keys <span class="text-xs font-normal text-muted-foreground/70">{{len .APIKeys}}</span></h2>
    <p class="mb-4 text-xs text-muted-foreground">Use a key as <span class="font-mono">PEEK_TOKEN</span> or as a Bearer token in scripts and integrations. A key acts as your account, with the same access.</p>
    <form method="POST" action="/dashboard/api-keys" class="mb-4 flex gap-2.5">
      <input type="hidden" name="csrf" value="{{.CSRF}}">
      <input type="text" name="name" placeholder="Key name, for example QA runner" required maxlength="100" class="h-10 min-w-[180px] flex-1 rounded-lg border border-input bg-secondary px-4 text-sm text-foreground placeholder:text-muted-foreground transition focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20">
      <button type="submit" class="h-10 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground transition hover:bg-primary/90">Create key</button>
    </form>
    {{if .APIKeys}}
    <div class="overflow-x-auto">
    <table class="w-full border-collapse text-sm">
      <thead><tr class="border-b border-border text-left text-[11px] font-medium uppercase tracking-wider text-muted-foreground"><th class="px-3 py-2">Name</th><th class="px-3 py-2">Key</th><th class="px-3 py-2">Created</th><th class="px-3 py-2">Last used</th><th class="px-3 py-2">Expires</th><th class="px-3 py-2"></th></tr></thead>
      <tbody>
      {{range .APIKeys}}
        <tr class="border-b border-border/50 last:border-0 hover:bg-foreground/[0.025]">
          <td class="h-10 px-3">{{.Name}}</td>
          <td class="px-3 font-mono text-muted-foreground">{{.Hint}}</td>
          <td class="px-3 text-muted-foreground">{{.Created}}</td>
          <td class="px-3 text-muted-foreground">{{.LastUsed}}</td>
          <td class="px-3 text-muted-foreground">{{.Expires}}</td>
          <td class="px-3">
            <div class="peek-row-actions">
              <form method="POST" action="/dashboard/api-keys/{{.ID}}/regenerate" data-confirm="Regenerate {{.Name}}? The current key stops working immediately." x-on:submit="confirm($event, $el.dataset.confirm)" class="m-0">
                <input type="hidden" name="csrf" value="{{$.CSRF}}">
                <button type="submit" class="peek-row-button">Regenerate</button>
              </form>
              <form method="POST" action="/dashboard/api-keys/{{.ID}}/revoke" data-confirm="Revoke {{.Name}}? It stops working immediately." x-on:submit="confirm($event, $el.dataset.confirm)" class="m-0">
                <input type="hidden" name="csrf" value="{{$.CSRF}}">
                <button type="submit" class="peek-row-button peek-row-button-danger">Revoke</button>
              </form>
            </div>
          </td>
        </tr>
      {{end}}
      </tbody>
    </table>
    </div>
    {{else}}
    <div class="py-10 text-center">
      <p class="text-sm text-foreground">No API keys yet.</p>
      <p class="mt-1.5 text-xs text-muted-foreground">Create a key above. Keys from <span class="font-mono">peek login</span> show up here as "CLI login".</p>
    </div>
    {{end}}
  </div>

</main>
{{template "toast-host" .}}
</body>
</html>{{end}}
